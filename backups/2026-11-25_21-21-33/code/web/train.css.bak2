/* ============================================================
   Deutsch Quest — раздел «Тренировка» (Lernen).
   Стиль — как у остального приложения: Liquid Glass карточки,
   плоский акцент (unslop), без градиентных кнопок и свечений.
   ============================================================ */

.tr-head {
  display: flex; flex-wrap: wrap; gap: 14px;
  justify-content: space-between; align-items: flex-end;
}
.tr-head-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }

/* A1–A2 — основной режим: маленькая точка на кнопке уровня */
.tr-levels button[data-level="a1"],
.tr-levels button[data-level="a2"] { position: relative; }
.tr-levels button[data-level="a1"]::after,
.tr-levels button[data-level="a2"]::after {
  content: ""; position: absolute; top: 6px; right: 9px;
  width: 5px; height: 5px; border-radius: 50%; background: var(--accent);
}
.tr-levels button.active::after { background: var(--on-accent); }

/* ---------- вкладки навыков ---------- */
.tr-tabs {
  display: flex; flex-wrap: wrap; gap: 4px; padding: 4px;
  background: var(--card2); border: 1px solid var(--line);
  border-radius: 16px; margin: 18px 0 6px;
}
.tr-tabs button {
  font: inherit; font-size: 14px; font-weight: 650; color: var(--dim);
  background: transparent; border: 0; cursor: pointer;
  padding: 10px 15px; border-radius: 12px;
  display: inline-flex; align-items: center; gap: 8px;
  transition: background .2s, color .2s;
}
.tr-tabs button:hover { color: var(--text); }
.tr-tabs button.active { background: var(--accent); color: var(--on-accent); }
.tr-tabs button .tr-tab-n {
  font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 999px;
  background: color-mix(in srgb, var(--text) 10%, transparent); color: inherit;
  font-variant-numeric: tabular-nums;
}
.tr-tabs button.active .tr-tab-n { background: rgba(0, 0, 0, .2); }
.tr-tabs button.is-priority:not(.active) { color: var(--text); }
.tr-tabs button.is-priority:not(.active) .tr-tab-n { color: var(--accent); }
.tr-skill-sub { margin: 0 0 14px; }

/* ---------- раскладка ---------- */
.tr-layout {
  display: grid; gap: 20px;
  grid-template-columns: minmax(0, 1fr) 300px;
  align-items: start;
}
@media (max-width: 980px) { .tr-layout { grid-template-columns: 1fr; } }

/* ---------- карточка задания ---------- */
.tr-card {
  background: var(--panel); border: 1px solid var(--hairline);
  border-radius: var(--radius); padding: 22px 24px 20px;
  box-shadow: 0 20px 50px -30px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .05);
}
.tr-counter {
  display: flex; align-items: center; gap: 12px;
  font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums;
  margin-bottom: 16px;
}
.tr-bar { flex: 1; height: 6px; border-radius: 999px; background: var(--card2); overflow: hidden; }
.tr-bar i { display: block; height: 100%; background: var(--accent); transition: width .3s ease; }

.tr-tag { font-size: 12px; color: var(--faint); letter-spacing: .04em; margin-bottom: 10px; }
.tr-prompt { margin-bottom: 16px; }

.tr-ru { font-size: 21px; font-weight: 650; line-height: 1.35; color: var(--text); }
.tr-note { margin: 6px 0 0; font-size: 13px; color: var(--faint); }
.tr-word { font-size: 26px; font-weight: 700; letter-spacing: -.01em; }
.tr-title { margin: 0 0 10px; font-size: 18px; }
.tr-text {
  font-size: 15.5px; line-height: 1.6; color: var(--text);
  background: var(--card2); border: 1px solid var(--line);
  border-radius: 14px; padding: 14px 16px;
}

/* кнопки «слушать» в Hören */
.tr-play {
  width: 54px; height: 54px; border-radius: 16px; cursor: pointer;
  display: inline-grid; place-items: center; margin-right: 8px;
  font-size: 22px; color: var(--on-accent);
  background: var(--accent); border: 1px solid var(--accent);
}
.tr-play.slow {
  width: 44px; height: 44px; font-size: 18px; margin-top: 5px;
  background: var(--card2); color: var(--text); border-color: var(--line);
}
.tr-play:hover { border-color: var(--text); }

/* ---------- варианты ответа ---------- */
.tr-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
@media (max-width: 640px) { .tr-opts { grid-template-columns: 1fr; } }
.tr-opt {
  font: inherit; font-size: 15px; font-weight: 600; color: var(--text);
  padding: 14px 16px; border-radius: 14px; cursor: pointer; text-align: left;
  background: var(--card2); border: 1px solid var(--line);
  transition: border-color .18s, background .2s, transform .08s;
}
.tr-opt:hover { border-color: color-mix(in srgb, var(--text) 32%, transparent); }
.tr-opt:active { transform: scale(.995); }
.tr-opt.sel { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, var(--card2)); }
.tr-opt.correct { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 18%, var(--card2)); }
.tr-opt.wrong { border-color: var(--bad); background: color-mix(in srgb, var(--bad) 18%, var(--card2)); }
.tr-opt:disabled { cursor: default; }

/* вопросы к тексту */
.tr-qs { display: grid; gap: 16px; }
.tr-q-text { font-size: 14.5px; font-weight: 650; margin-bottom: 8px; color: var(--dim); }

/* ---------- Schreiben: сборка предложения ---------- */
.tr-build {
  min-height: 62px; display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start;
  padding: 10px; margin-bottom: 12px;
  background: var(--card2); border: 1px dashed var(--hairline); border-radius: 14px;
}
.tr-build:empty::before {
  content: "Соберите фразу здесь…"; color: var(--faint); font-size: 13px;
  align-self: center; padding-left: 6px;
}
.tr-words { display: flex; flex-wrap: wrap; gap: 8px; }
.tr-chip {
  font: inherit; font-size: 15px; font-weight: 600; color: var(--text);
  padding: 9px 14px; border-radius: 12px; cursor: pointer;
  background: var(--card2); border: 1px solid var(--line);
  transition: border-color .15s, background .2s, opacity .2s;
}
.tr-chip:hover { border-color: color-mix(in srgb, var(--text) 32%, transparent); }
.tr-chip.used { opacity: .3; cursor: default; }
.tr-chip.in { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--card2)); }
.tr-chip.in:hover { border-color: var(--bad); }
.tr-chip.ok { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 16%, var(--card2)); }
.tr-chip.bad { border-color: var(--bad); background: color-mix(in srgb, var(--bad) 16%, var(--card2)); }
.tr-chip:disabled { cursor: default; }

/* ---------- Schreiben: ввод перевода ---------- */
.tr-write-row { display: flex; flex-direction: column; gap: 6px; }
.tr-input { font-size: 17px; padding: 14px 16px; border-radius: 14px; }
.tr-input.ok { border-color: var(--ok); }
.tr-input.bad { border-color: var(--bad); }
.tr-input-extra { align-self: flex-end; }

/* ---------- фидбек и разбор ---------- */
.tr-feedback { min-height: 24px; margin-top: 14px; font-size: 14px; font-weight: 600; }
.tr-feedback.ok { color: var(--dim); font-weight: 500; }
.tr-feedback.ok.has-explain { color: var(--text); font-weight: 600; }
.tr-feedback.bad { color: var(--bad); }
.tr-feedback.warn { color: var(--warn); font-weight: 500; }
.tr-feedback.review { color: var(--dim); font-weight: 500; }
.tr-explain {
  margin-top: 8px; padding: 12px 14px;
  background: var(--card2); border: 1px solid var(--line); border-radius: 12px;
  font-size: 13.5px; line-height: 1.55; color: var(--dim); font-weight: 500;
}
.tr-explain b { color: var(--text); }
.tr-diff { margin: 8px 0 6px; font-size: 14px; line-height: 1.7; }
.tr-diff .w-ok { color: var(--ok); }
.tr-diff .w-bad {
  color: var(--bad); text-decoration: line-through;
  text-decoration-thickness: 1px;
  text-decoration-color: color-mix(in srgb, var(--bad) 60%, transparent);
}

.tr-actions { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; align-items: center; }
.tr-actions .btn.primary { margin-left: auto; }
.tr-actions .btn[hidden] { display: none; }
.tr-empty { padding: 26px; text-align: center; color: var(--dim); }

/* ---------- панель прогресса ---------- */
.tr-progress-panel h3 { margin: 0 0 12px; font-size: 13px; color: var(--faint); font-weight: 600; }
.tr-pr-top {
  display: flex; justify-content: space-between; font-size: 13px; color: var(--dim);
  padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px solid var(--line);
}
.tr-pr-top b { color: var(--text); font-variant-numeric: tabular-nums; }
.tr-pr-row { display: flex; align-items: center; gap: 10px; padding: 5px 6px; border-radius: 10px; }
.tr-pr-row.cur { background: color-mix(in srgb, var(--accent) 8%, transparent); }
.tr-pr-lv {
  font: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
  width: 38px; flex: none; padding: 5px 0; border-radius: 8px;
  background: var(--card2); color: var(--dim); border: 1px solid var(--line);
}
.tr-pr-row.cur .tr-pr-lv { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
.tr-pr-cells { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; flex: 1; }
.tr-pc {
  position: relative; height: 22px; border-radius: 6px; overflow: hidden;
  background: var(--card2); border: 1px solid var(--line);
  display: grid; place-items: center;
}
.tr-pc i {
  position: absolute; inset: 0 auto 0 0; width: var(--p, 0%);
  background: color-mix(in srgb, var(--accent) 45%, transparent);
}
.tr-pc em {
  position: relative; font-style: normal; font-size: 10px; font-weight: 700;
  color: var(--dim); letter-spacing: .02em;
}
.tr-pc.cur { border-color: var(--accent); }
.tr-pc.cur em { color: var(--text); }

@media (max-width: 980px) { .tr-progress-panel { order: 2; } }
@media (max-width: 640px) {
  .tr-card { padding: 16px; }
  .tr-tabs button { padding: 9px 11px; font-size: 13px; }
}
